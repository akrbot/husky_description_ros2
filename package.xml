<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>husky_description</name>
  <version>0.0.0</version>
  <description>Husky robot description and Gazebo simulation package for ROS 2.</description>
  <maintainer email="akr.workspace@gmail.com">akr</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>xacro</depend>
  <depend>urdf</depend>
  <depend>ament_cmake</depend>
  <depend>geometry_msgs</depend> <!-- if you use transforms in launch files -->
  <depend>rviz2</depend> <!-- optional, for launch -->
 
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
